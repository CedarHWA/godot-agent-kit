# Godot 4 cache. Keep .uid and *.import sidecars under version control.
.godot/
*.tmp
*.log
.DS_Store
Thumbs.db
.local/
.bootstrap/proposals/
.bootstrap/last-run.json
.venv/
__pycache__/
*.pyc
builds/
work/*
